# Copia a .env.local (no se sube a git). Nunca pegues claves en chats ni documentos.
# Base de datos: vacío = PGlite local en .data/ (solo desarrollo). En producción, una URL de Postgres.
DATABASE_URL=
# Clave maestra para cifrar credenciales por empresa (32 bytes en base64). Genera una con: openssl rand -base64 32
APP_SECRET=
# IA: sin clave, los empleados NO ejecutan tareas y la interfaz lo dice.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5
# Tarifas USD por millón de tokens (necesarias para calcular costo y límites)
MODEL_INPUT_USD_PER_MTOK=
MODEL_OUTPUT_USD_PER_MTOK=
# Composio (capa central de integraciones). Sin clave, el centro de conexiones lo marca "sin configurar".
COMPOSIO_API_KEY=
# Token que protege el endpoint del programador de automatizaciones
CRON_SECRET=

# --- Mensajería (Mi oficina en el celular) ---
# Telegram (Bot API): crea un bot con @BotFather. El secreto del webhook lo eliges tú (A-Z a-z 0-9 _ -, 1-256 caracteres).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# WhatsApp Business Platform (Cloud API): ver docs/MENSAJERIA.md para requisitos de cuenta, número y plantillas.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v21.0
# Plantilla APROBADA (1 parámetro de cuerpo) para avisos fuera de la ventana de 24 h. Sin ella, esos avisos se omiten.
WHATSAPP_TEMPLATE_NOTIFY=
WHATSAPP_TEMPLATE_LANG=es
# Solo pruebas locales: apunta a un servidor simulado en vez de api.telegram.org / graph.facebook.com
TELEGRAM_API_BASE=
WHATSAPP_API_BASE=

# Piloto privado: solo estos correos pueden crear cuenta (separados por coma). Vacío = registro abierto.
SIGNUP_ALLOWED_EMAILS=

# --- Sistema comercial ---
# Operadores del panel /admin (correos separados por coma). Vacío = nadie entra al panel.
PLATFORM_ADMIN_EMAILS=
# Cobros: DEJAR EN false. Solo se activa cuando José autorice una pasarela y exista su implementación (PaymentProvider).
BILLING_ENABLED=false
# Precios mensuales en USD que se muestran en /planes. Sin valor = «Precio por confirmar». No inventes cifras.
PLAN_PRICE_USD_EMPRENDEDOR=
PLAN_PRICE_USD_AGENCIA=
PLAN_PRICE_USD_AVANZADO=

# --- Pre-lanzamiento ---
# Dirección pública con https y correo de contacto (se fijan ANTES de compilar). Revisa todo con: npm run preflight
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
# Pasarela (Stripe México, SOLO modo pruebas mientras no haya autorización). Precios en pesos:
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLAN_PRICE_MXN_EMPRENDEDOR=
PLAN_PRICE_MXN_AGENCIA=
PLAN_PRICE_MXN_AVANZADO=
# Pruebas contra PostgreSQL real: TEST_DATABASE_URL=postgres://usuario:clave@127.0.0.1:5432/base_de_pruebas

# --- Modelo de venta directa (LANDING → PAGO → OFICINA AUTOMÁTICA) ---
# Registro público CERRADO por defecto: las cuentas nacen al comprar. Solo "true" lo abre (no recomendado).
PUBLIC_SIGNUP=
# Plan que se vende y plan de cada oficina adicional (precio en PLAN_PRICE_MXN_<PLAN>). Por defecto: emprendedor.
OFFER_PLAN=emprendedor
NEW_OFFICE_PLAN=
# Correo transaccional (Resend). Sin esto la tienda NO abre. MAIL_FROM debe ser un remitente de un dominio verificado en Resend.
RESEND_API_KEY=
MAIL_FROM=
# Secreto del webhook de Resend (confirma entregas/rebotes en /admin/correos). Opcional pero recomendado.
RESEND_WEBHOOK_SECRET=
# Dirección pública (https) para los enlaces de los correos (si no, se usa NEXT_PUBLIC_SITE_URL).
SITE_URL=
# Horas que vale la verificación de IA para mantener la tienda abierta (npm run ai:verify / botón en /admin/conversion).
AI_VERIFY_MAX_AGE_H=48
# Solo pruebas locales: apuntan a servidores simulados.
MAIL_API_BASE=
# ANTHROPIC_BASE_URL=

# Router de IA (apagado por defecto). Ver docs/ia-router/ROUTER.md
AI_ROUTER=off
# OPENROUTER_API_KEY=   (secreto: cárgalo con deploy/convivencia/configurar_openrouter.sh, nunca en Git)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
