# Copia a .env.local (no se sube a git). Nunca pegues claves en chats ni documentos.
# Base de datos: vacío = PGlite local en .data/ (solo desarrollo). En producción, una URL de Postgres.
DATABASE_URL=
# Clave maestra para cifrar credenciales por empresa (32 bytes en base64). Genera una con: openssl rand -base64 32
APP_SECRET=
# IA: sin clave, los empleados NO ejecutan tareas y la interfaz lo dice.
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5
# Tarifas USD por millón de tokens (necesarias para calcular costo y límites)
MODEL_INPUT_USD_PER_MTOK=
MODEL_OUTPUT_USD_PER_MTOK=
# Composio (capa central de integraciones). Sin clave, el centro de conexiones lo marca "sin configurar".
COMPOSIO_API_KEY=
# Token que protege el endpoint del programador de automatizaciones
CRON_SECRET=

# --- Mensajería (Mi oficina en el celular) ---
# Telegram (Bot API): crea un bot con @BotFather. El secreto del webhook lo eliges tú (A-Z a-z 0-9 _ -, 1-256 caracteres).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# WhatsApp Business Platform (Cloud API): ver docs/MENSAJERIA.md para requisitos de cuenta, número y plantillas.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v21.0
# Plantilla APROBADA (1 parámetro de cuerpo) para avisos fuera de la ventana de 24 h. Sin ella, esos avisos se omiten.
WHATSAPP_TEMPLATE_NOTIFY=
WHATSAPP_TEMPLATE_LANG=es
# Solo pruebas locales: apunta a un servidor simulado en vez de api.telegram.org / graph.facebook.com
TELEGRAM_API_BASE=
WHATSAPP_API_BASE=
